# Copy to .env and fill in. Everything here is free tier.

# ── Model ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
AGENT_MODEL=gpt-5.6-sol          # any OpenAI model id from TrueForge's catalog
VISION_MODEL=gpt-5.4-mini        # used by browser-lab's vision double-check

# ── Tickets and code ─────────────────────────────────────────────────────
LINEAR_API_KEY=                  # Linear → Settings → Security & access → Personal API keys
LINEAR_TEAM_KEY=                 # e.g. DEM (used by scripts/seed-linear.mjs)
GITHUB_TOKEN=                    # optional: defaults to `gh auth token`
TARGET_REPO=https://github.com/yeah-ssh/demo-shop


# ── Evidence and replies ─────────────────────────────────────────────────
EVIDENCE_STORE=github            # github | local
EVIDENCE_REPO=yeah-ssh/show-dont-tell-evidence
RESEND_API_KEY=                  # optional: without it, replies go to .lab/outbox.jsonl + Linear only
REPLY_FROM=Demo Shop Support <onboarding@resend.dev>
REPLY_OVERRIDE_TO=               # demo safety net: send every reply to this address instead

# ── Runtime ──────────────────────────────────────────────────────────────
TRUEFORGE_URL=http://localhost:8790
LAB_RUNNER=host                  # host | docker (docker: build browser-lab/Dockerfile first)
LINEAR_WEBHOOK_SECRET=           # for the dispatcher (Linear → Settings → API → Webhooks)

# Auto-triage: a TrueForge Schedule sweeps Linear for new bug tickets
TRIAGE_SCHEDULE=active           # active | paused
